{
  "name": "spreadsheet-utils",
  "version": "1.0.0",
  "description": "Ultra-lightweight, low-memory universal spreadsheet toolkit merging read-excel-file streaming SAX reader with TabularJS multi-format plugins and styled write-excel-file writer. Supports 16+ formats (XLSX, XLS, ODS, CSV, TSV, DBF, DIF, Lotus 1-2-3, SLK, HTML tables, XML Spreadsheet, Apple Numbers) in Node.js and Browser.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "browser": "./dist/browser/spreadsheet-utils.min.js",
  "types": "./index.d.ts",
  "bin": {
    "spreadsheet-utils": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Illimitable-Consulting-Private-Limited/spreadsheet-utils.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./plugins": {
      "types": "./plugins.d.ts",
      "import": "./dist/esm/plugins.mjs",
      "require": "./dist/cjs/plugins.cjs",
      "default": "./dist/esm/plugins.mjs"
    },
    "./write": {
      "types": "./write.d.ts",
      "import": "./dist/esm/write.mjs",
      "require": "./dist/cjs/write.cjs",
      "default": "./dist/esm/write.mjs"
    },
    "./full": {
      "types": "./full.d.ts",
      "import": "./dist/esm/full.mjs",
      "require": "./dist/cjs/full.cjs",
      "default": "./dist/esm/full.mjs"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "import": "./dist/esm/worker.mjs",
      "require": "./dist/cjs/worker.cjs",
      "default": "./dist/esm/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "index.d.ts",
    "plugins.d.ts",
    "write.d.ts",
    "full.d.ts",
    "worker.d.ts",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "node scripts/build.js",
    "test": "mocha \"src/**/*.test.js\" \"test/**/*.test.js\"",
    "test:integration": "mocha test/integration/**/*.test.js",
    "test:read-excel-file": "mocha test/read-excel-file/testCases.test.js",
    "test:tabularjs": "mocha \"test/tabularjs/**/*.test.js\"",
    "sync:check": "node scripts/sync-upstream.js --check",
    "sync:pull": "node scripts/sync-upstream.js --sync",
    "sync:verify": "node scripts/sync-upstream.js --verify"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "xlsx",
    "xls",
    "ods",
    "csv",
    "tsv",
    "dbf",
    "lotus",
    "numbers",
    "streaming",
    "low-memory",
    "read-excel-file",
    "write-excel-file",
    "tabularjs",
    "parser",
    "writer",
    "export"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3",
    "saxen": "^11.2.0",
    "unzipper-esm": "^0.13.3"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3"
  }
}
